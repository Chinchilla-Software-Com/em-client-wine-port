@="EMClientWinePort.dot"

[HKEY_CLASSES_ROOT\EMClientWinePort.dot\shell\open\command]
@="\"c:\\windows\\system32\\winebrowser.exe\" \"%1\""

[HKEY_CLASSES_ROOT\.dotx]
@="EMClientWinePort.dotx"

[HKEY_CLASSES_ROOT\EMClientWinePort.dotx\shell\open\command]
@="\"c:\\windows\\system32\\winebrowser.exe\" \"%1\""

[HKEY_CLASSES_ROOT\.dotm]
@="EMClientWinePort.dotm"

[HKEY_CLASSES_ROOT\EMClientWinePort.dotm\shell\open\command]
@="\"c:\\windows\\system32\\winebrowser.exe\" \"%1\""

