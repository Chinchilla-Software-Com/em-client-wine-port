# Vendor/reference binaries - untouched, reproducible from the eM Client installer
original/

# Build artifacts from the Cecil patcher - regenerable from original/ + patch specs
il-patches/output*/
il-patches/backup/
il-patches/bottle-backups/

# ilspycmd decompile output - regenerable from original/ or il-patches/output/
decompiled/

# CX_DEBUGMSG trace captures - large, ephemeral, regenerable by rerunning under trace
reports/cxlog*.txt
reports/cxlog*.txt.bak

# releases/<version>/deploy.sh's own backups of live bottle files before patching - contain a
# copy of whatever eM Client build the user has installed, not something to commit
releases/*/backups/
